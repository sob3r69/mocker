{
  "name": "mock-http-server",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build -w @mocker/shared && concurrently -k -n shared,server,client \"npm run dev -w @mocker/shared\" \"npm run dev -w @mocker/server\" \"npm run dev -w @mocker/client\"",
    "build": "npm run build -w @mocker/shared && npm run build -w @mocker/server && npm run build -w @mocker/client",
    "start": "npm run start -w @mocker/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:smoke": "npm run build && node scripts/backend-smoke.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "katex": "^0.19.1"
  }
}
